APP_ENV=local

# --- Postgres container ---
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
POSTGRES_PORT=5432

# --- Host ports ---
BACKEND_PORT=3333
FRONTEND_PORT=3000
PDF_SERVICE_PORT=8080
LOCALSTACK_PORT=4566

# --- Frontend ---
# Reverse proxies in front of the frontend that append to X-Forwarded-For (0 = none).
FRONTEND_TRUSTED_PROXY_HOPS=0

# --- AWS / LocalStack access ---

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# --- LocalStack bootstrap input ---
S3_BUCKET=orders-platform
S3_PRODUCT_IMAGE_PREFIX=products/
S3_THUMBNAIL_PREFIX=thumbnails/
S3_PUBLIC_ENDPOINT=http://localhost:4566
FRONTEND_ORIGIN=http://localhost:3000
S3_INVOICE_PREFIX=invoices/
SQS_ORDERS_QUEUE=orders-queue
SQS_INVOICE_READY_QUEUE=invoice-ready-queue
SNS_ORDER_TOPIC=order-notifications
DYNAMO_CARTS_TABLE=carts
DYNAMO_STOCK_CACHE_TABLE=stock_cache
JWT_EXPIRES_IN=1h
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
TRUSTED_PROXIES=uniquelocal
PDF_WORKER_CONCURRENCY=4
